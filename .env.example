# Supabase (Auth + DB + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key (server-side only — used for admin operations like invite token validation)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI (GPT-4.1 — primary LLM)
OPENAI_API_KEY=your_openai_key

# Deepgram (STT — cross-browser WebSocket streaming)
DEEPGRAM_API_KEY=your_deepgram_key
# Required for production: enables short-lived scoped keys instead of exposing main key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id

# ElevenLabs (TTS — 5 voices + emotion modulation)
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_AUTHORITATIVE_MALE=BUJMBsQ3Oq4cEeWSb48y
ELEVENLABS_VOICE_WARM_FEMALE=imRmmzTqlLHt9Do1HufF
ELEVENLABS_VOICE_STRESSED_YOUNG=Xgb3SR8idOHy8scGICeJ
ELEVENLABS_VOICE_CALM_NARRATOR=BVBq6HVJVdnwOMJOqvy9
ELEVENLABS_VOICE_GRUFF_VETERAN=F9KUTOne5xOKqAbIU7yg

# Mistral — persona conversation model (default mistral:open-mistral-nemo, ~300 ms to first token)
MISTRAL_API_KEY=your_mistral_key

# Simulation models ("provider:model"; bare names = OpenAI). Pinned per session.
# SIMULATION_CONVERSATION_MODEL=mistral:open-mistral-nemo
# SIMULATION_JUDGE_MODEL=gpt-4.1

# Voice. Gradium is the production provider (STT + TTS). Without it, STT uses Deepgram
# and TTS uses OpenAI gpt-4o-mini-tts through /api/simulation/voice/speak.
# GRADIUM_API_KEY=your_gradium_key
# GRADIUM_VOICE_ID=
# SIMULATION_FALLBACK_VOICE=coral
# SIMULATION_FALLBACK_TTS_MODEL=gpt-4o-mini-tts

# Development-only alternate speech providers; production uses Gradium.
SIMULATION_ENABLE_VOICE_FALLBACK=false
